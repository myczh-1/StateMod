[
  {
    "family": "tab_stop_expansion",
    "name": "collect_tab_views",
    "arg": "texts",
    "member_type": "str",
    "operation": "texts 是字符串列表。对每个字符串执行 Python 的 expandtabs(4)，按每四列一个制表位展开制表符，保留换行等其他字符，收集处理后的字符串。",
    "expression": "text.expandtabs(4) for text in texts",
    "cases": [
      [
        "empty",
        [],
        []
      ],
      [
        "duplicates",
        [
          "a\tb",
          "a\tb",
          "ab\tc"
        ],
        [
          "a   b",
          "ab  c"
        ]
      ],
      [
        "boundary",
        [
          "\t",
          "abcd\tX",
          "a\n\tb",
          ""
        ],
        [
          "    ",
          "abcd    X",
          "a\n    b",
          ""
        ]
      ],
      [
        "ordinary",
        [
          "plain",
          "xy\tz"
        ],
        [
          "plain",
          "xy  z"
        ]
      ]
    ],
    "nearest": [
      "trim_members",
      "word_wrap_lines",
      "justify_spaces"
    ],
    "review": "Tab expansion depends on running column and resets at line boundaries. It is neither boundary stripping nor line packing/space justification; one fixed replacement of tab cannot implement the cases."
  },
  {
    "family": "python_literal_representation",
    "name": "collect_literal_views",
    "arg": "texts",
    "member_type": "str",
    "operation": "texts 是字符串列表。对每个元素调用 Python 内置 repr，收集得到的字符串表示；引号、反斜杠和转义序列都是结果的一部分，不要调用 eval。",
    "expression": "repr(text) for text in texts",
    "cases": [
      [
        "empty",
        [],
        []
      ],
      [
        "duplicates",
        [
          "a",
          "a",
          "can't"
        ],
        [
          "'a'",
          "\"can't\""
        ]
      ],
      [
        "boundary",
        [
          "",
          "\n",
          "\\"
        ],
        [
          "''",
          "'\\n'",
          "'\\\\'"
        ]
      ],
      [
        "ordinary",
        [
          "中文",
          "a\tb"
        ],
        [
          "'中文'",
          "'a\\tb'"
        ]
      ]
    ],
    "nearest": [
      "escape_ampersands",
      "quoted_printable_octets",
      "scalar_type_names"
    ],
    "review": "Python source-literal representation of a whole string, including delimiters and context-sensitive quote choice, differs from replacing one character, byte transfer encoding, or runtime type-name lookup."
  },
  {
    "family": "centered_text_padding",
    "name": "collect_centered_views",
    "arg": "texts",
    "member_type": "str",
    "operation": "texts 是字符串列表。对每个字符串调用 center(6, \".\")，收集居中后的字符串；宽度已经达到六或超过六的字符串保持原样，奇数填充遵循该 Python 方法。",
    "expression": "text.center(6, '.') for text in texts",
    "cases": [
      [
        "empty",
        [],
        []
      ],
      [
        "duplicates",
        [
          "ab",
          "ab",
          "a"
        ],
        [
          "..ab..",
          "..a..."
        ]
      ],
      [
        "boundary",
        [
          "",
          "123456",
          "1234567"
        ],
        [
          "......",
          "123456",
          "1234567"
        ]
      ],
      [
        "ordinary",
        [
          "abc",
          "abcd",
          "abcde"
        ],
        [
          ".abc..",
          ".abcd.",
          "abcde."
        ]
      ]
    ],
    "nearest": [
      "justify_spaces",
      "word_wrap_lines",
      "grouped_decimal_strings"
    ],
    "review": "Symmetric fixed-width boundary padding of each independent string is distinct from distributing spaces between words or wrapping lines. Width is fixed before inference; this is one family, not multiple widths counted separately."
  },
  {
